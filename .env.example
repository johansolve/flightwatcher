PORT=8090
# Selected location on first visit
DEFAULT_LOCATION=AGH
# Initial airport list for new visitors (IATA or ICAO codes); each visitor can edit their own list
DEFAULT_LOCATIONS=HAD,AGH,CPH,GOT,ARN
DEFAULT_RADIUS_KM=10
MAX_RADIUS_KM=50
# FlightAware AeroAPI (Personal tier). Without it, routes are shown but no times.
AEROAPI_KEY=
# Optional contact appended to the User-Agent sent to upstream APIs
CONTACT=
