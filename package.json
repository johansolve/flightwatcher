{
    "name": "flightwatcher",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
        "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "jshint public/app.js"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "jshint": "^2.13.6",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@fontsource-variable/alegreya": "^5.3.0",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/josefin-sans": "^5.3.0",
        "@fontsource-variable/jost": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/im-fell-english-sc": "^5.3.0",
        "@fontsource/yellowtail": "^5.3.0",
        "leaflet": "^1.9.4"
    }
}
